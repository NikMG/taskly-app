{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/test-agent-report.schema.json",
  "title": "Test agent report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "decision",
    "summary",
    "files_analyzed",
    "tests_written",
    "suspected_bugs",
    "obsolete_tests",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "pr",
        "backfill"
      ]
    },
    "decision": {
      "enum": [
        "tests_created",
        "tests_updated",
        "tests_created_and_updated",
        "no_tests_needed",
        "needs_human",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "files_analyzed": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "stack",
          "needs_tests",
          "reason",
          "left_untested"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "stack": {
            "enum": [
              "backend",
              "frontend"
            ]
          },
          "needs_tests": {
            "type": "boolean",
            "description": "Your decision: does this file have behaviour that deserves tests? Answer it the same way whether or not you finished them."
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          },
          "left_untested": {
            "type": "string",
            "maxLength": 300,
            "description": "Backfill mode: for a file that still has a missed line or branch in the final full run, name the code left untested and why a test is not worth having, concretely. Use an empty string if nothing is left, if the work on this file is unfinished (the run then counts as incomplete), and always in pr mode."
          }
        }
      }
    },
    "tests_written": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "covers",
          "rationale"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "action": {
            "enum": [
              "created",
              "updated"
            ]
          },
          "covers": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "rationale": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "suspected_bugs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "description",
          "evidence"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000000
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "evidence": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "obsolete_tests": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "test_name",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "test_name": {
            "type": "string",
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
